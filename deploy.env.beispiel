# Kopie als deploy.env anlegen und ausfuellen. deploy.env ist gitignored.
# Dieselben Werte wie in der .env der Website - es ist derselbe Server.
FTP_HOST=wXXXXXXX.kasserver.com
FTP_USER=fXXXXXXX
FTP_PASS=
# Nur setzen, wenn der FTP-Zugang NICHT auf das Verzeichnis der Domain
# beschraenkt ist. Dann mit Schraegstrich am Ende, z. B. www/bauzeuge.de/
FTP_DIR=
